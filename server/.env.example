NODE_ENV=development
PORT=5000

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/edge_institute

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE=30d

# CORS - comma separated origins allowed to call the API
